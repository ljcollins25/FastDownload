<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <remove key="OverridePackages" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="BuildXL.External">
      <!-- Override packages served from local folder. This should sync with OverridePackage in build/setup-dependencies.proj -->
      <package pattern="Microsoft.BuildXL.Interop.Runtime.osx-x64" />
    </packageSource>

    <packageSource key="nuget.org">
      <!-- fallback: everything else comes from nuget.org -->
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
