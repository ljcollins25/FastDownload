<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BuildXLPublicPackagesVersion Condition="'$(BuildXLPublicPackagesVersion)' == ''">0.1.0-20251031.4</BuildXLPublicPackagesVersion>
    <BuildXLPublicPackages_RestoreSource Condition="'$(BuildXLPublicPackages_RestoreSource)' == ''">https://pkgs.dev.azure.com/mseng/PipelineTools/_packaging/BuildXL.External/nuget/v3/index.json</BuildXLPublicPackages_RestoreSource>
    <RestoreSources Condition="'$(BuildXLPublicPackages_RestoreSource)' != ''">$(RestoreSources);$(BuildXLPublicPackages_RestoreSource)</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.BuildXL.Cache.ContentStore.Hashing" Version="$(BuildXLPublicPackagesVersion)" />
    <PackageVersion Include="Microsoft.BuildXL.Cache.ContentStore.Interfaces" Version="$(BuildXLPublicPackagesVersion)" />
    <PackageVersion Include="Microsoft.BuildXL.Cache.ContentStore.Library" Version="$(BuildXLPublicPackagesVersion)" />
    <PackageVersion Include="Microsoft.BuildXL.Utilities" Version="$(BuildXLPublicPackagesVersion)" />
    <PackageVersion Include="Microsoft.BuildXL.Utilities.Core" Version="$(BuildXLPublicPackagesVersion)" />


    <PackageVersion Include="Azure.Storage.Blobs" Version="12.16.0" />
    <PackageVersion Include="BuildXL.Azurite.Executables"  Version="1.0.0-CI-20250114-025011"/>
    <PackageVersion Include="DotNext.Unsafe" Version="5.18.0" />
    <PackageVersion Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="8.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="3.10.4" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.10.4" />
    <PackageVersion Include="NLog" Version="5.2.3" />
    <PackageVersion Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="9.0.9"/>
    <PackageVersion Include="System.Text.Encodings.Web" Version="9.0.5" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.4" />
  </ItemGroup>
</Project>