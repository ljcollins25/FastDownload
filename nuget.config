<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BuildXLExternal" value="https://pkgs.dev.azure.com/mseng/PipelineTools/_packaging/BuildXL.External/nuget/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="BuildXLExternal">
      <!-- BuildXL packages served from the internal feed -->
      <package pattern="Microsoft.BuildXL.*" />
      <package pattern="BuildXL.*" />
    </packageSource>

    <packageSource key="nuget.org">
      <!-- fallback: everything else comes from nuget.org -->
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>